# BluMan Backend — Variabili d'ambiente
# Copia questo file in .env e compila i valori reali
# NON committare mai il file .env

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (solo backend, mai frontend)
SUPABASE_ANON_KEY=eyJ...      # anon key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# ── DocuSign ──────────────────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=docusign_private.key
# Per produzione cambiare in: https://na4.docusign.net/restapi
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# ── Email (Postmark) ─────────────────────────────────────────
POSTMARK_TOKEN=
EMAIL_FROM=noreply@blucode.com
EMAIL_FROM_NAME=Bluecode Advisory

# ── App ───────────────────────────────────────────────────────
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
