# ─────────────────────────────────────────────────────────────────────
# BLUMAN — .env di PRODUZIONE per il deployment su VPS (docker-compose.prod.yml)
# Copia questo file in `.env` ACCANTO a docker-compose.prod.yml e riempi i valori.
# NON committare il .env reale. Genera i segreti con i comandi indicati.
# ─────────────────────────────────────────────────────────────────────

# ═══ 1) Variabili lette dal COMPOSE (interpolazione ${VAR:?}) — obbligatorie ═══
# Proprietario dello schema (esegue le migrazioni). NON è il ruolo dell'app.
POSTGRES_USER=bluman_owner
# ATTENZIONE: le due password del DB vanno generate in ESADECIMALE, non base64.
# Il compose le INTERPOLA dentro l'URL di connessione (postgresql://utente:PASSWORD@postgres:5432/db):
# il base64 contiene anche `/` e `+`, che dentro un URL sono separatori/riservati. La password viene
# tagliata lì e Prisma legge il resto come host e porta → `P1013: invalid port number in database URL`,
# che sembra un errore di rete e invece è un carattere di troppo. Vedi docs/vps-primo-avvio.md §1.
POSTGRES_PASSWORD=            # openssl rand -hex 32
POSTGRES_DB=bluman
# Ruolo applicativo `bluman_app` (SENZA bypassrls) con cui gira l'API — lo crea il servizio `rls`.
APP_DB_PASSWORD=             # openssl rand -hex 32  (esadecimale, NON base64)
# Firma dei JWT di sessione. Con un JWT_SECRET noto salta l'isolamento RLS: tienilo segreto.
JWT_SECRET=                  # openssl rand -hex 32
# Webhook SDI: vuoto = rotta 503 (disattivata). Impostalo solo se usi l'ingestione SDI firmata.
WEBHOOK_SECRET_SDI=          # openssl rand -hex 32 (opzionale)

# NB: DATABASE_URL e DIRECT_URL NON vanno qui — le imposta il compose (bluman_app / owner sul
# Postgres locale). Se le metti, il compose le sovrascrive comunque.

# ═══ 2) Variabili RUNTIME dell'app (lette dall'api via env_file) ═══
# Sigillo HMAC delle firme elettroniche (evidenza legale). Obbligatorio in produzione.
SIGILLO_HMAC_SECRET=         # openssl rand -hex 32
# URL pubblico dell'app (per magic link, link nei messaggi, ecc.).
APP_BASE_URL=https://IL.TUO.DOMINIO
# Origini CORS ammesse (il frontend). Es. https://bluman.vercel.app oppure il dominio del VPS.
CORS_ORIGINS=https://IL.TUO.DOMINIO

# ── Posta (SMTP invio / IMAP ingestione) e relay ──
EMAIL_RELAY_SECRET=          # deve coincidere con quello della funzione /api/send-email se usata
EMAIL_RELAY_URL=             # vuoto = invio SMTP diretto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SERVERNAME=             # solo se il certificato SMTP attesta un host diverso

# ── Canali (opzionali; per-studio si configurano anche da Impostazioni) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
WA_PHONE_ID=
WA_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# ── Backup / osservabilità ──
BACKUP_ENCRYPTION_KEY=       # cifratura dei dump (scripts/backup-vps.sh)
LOG_LEVEL=info
SENTRY_DSN=

# ── Storage documenti ──
# Opzione B (tutto sul VPS): i documenti stanno sul disco locale (volume bluman_uploads) e
# NON servono SUPABASE_URL/SUPABASE_SERVICE_KEY. Lasciale vuote per usare lo storage locale.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ═══ 3) Cosa NON sta in questo file ═══
# Il FRONTEND servito da nginx si compila dichiarando la stessa origine dell'API:
#   cd frontend && VITE_API_SAME_ORIGIN=true npm run build
# Senza quel flag `frontend/src/api/http.ts` rifiuta la base (è lo stesso dominio della pagina) e
# ricade sul backend Railway **senza dirlo**: l'app funziona, ma parla con l'ambiente sbagliato —
# il guasto peggiore, perché non si annuncia. Vedi `docs/vps-primo-avvio.md` §1.
