{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.prod)",
      "Read(./.env.production)",
      "Read(./frontend/.env)",
      "Read(./frontend/.env.local)",
      "Read(./frontend/.env.production)",
      "Read(./**/dist/**)",
      "Read(./**/node_modules/**)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push upstream:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npx --no-install prisma db push:*)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(npx --no-install prisma migrate deploy:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx --no-install prisma migrate reset:*)",
      "Bash(*--accept-data-loss*)",
      "Bash(railway:*)",
      "Bash(npx railway:*)",
      "Bash(npx --yes @railway/cli:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(bash scripts/distribuisci.sh:*)",
      "Bash(./scripts/distribuisci.sh:*)",
      "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/no-full-suite.cjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stato.cjs"
          }
        ]
      }
    ]
  }
}
