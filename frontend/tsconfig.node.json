{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // `src/test/setup.ts` NON sta qui: è un file di ambiente jsdom e questo progetto ha
  // `lib: ["ES2023"]`, senza DOM — compilarlo in entrambi i progetti lo faceva fallire qui
  // («Cannot find name 'Element'») pur essendo corretto. Lo copre già tsconfig.app.json, che
  // include tutto `src` con la libreria DOM.
  "include": ["vite.config.ts"]
}
