# progetto.env — i valori di QUESTO progetto per gli script comuni di scripts/
# (automerge.sh, review-label.sh, ci-rossa.sh, sentinella.sh; deploy.sh e
# prova-ripristino.sh non girano qui: vedi sotto). Versionato, niente segreti (quelli
# stanno nei secret di GitHub). Gli script comuni sono identici in ogni progetto e si
# aggiornano con strumenti/aggiorna-metodo.sh dello Standard: quello che cambia fra un
# progetto e l'altro si scrive qui, non negli script.

# Nome negli avvisi Telegram.
NOME_PROGETTO="bluman"

# Cartella dell'interfaccia: un deploy che cambia solo questa è «solo-web».
WEB_RE='^frontend/'

# Nessun deploy dal fork wolftradesystem-tech/bluman (docs/adozione-standard.md):
# deploy.sh, backup.sh e prova-ripristino.sh non hanno un server su cui girare, e la
# prova dello schema del progetto sarebbe `prisma migrate deploy` su una copia, non un
# db push. Vuoti di proposito: si compilano il giorno in cui un server entra nel pilota.
DB_URL_FILE=
PROVA_SCHEMA_CMD=''
TABELLE_DA_CONTARE=""
TABELLE_DA_MOSTRARE=""
MISURA_RIAVVIO_CMD=""
MISURA_RIAVVIO_NOME=""
