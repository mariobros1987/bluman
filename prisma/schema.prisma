  // query paginata GET /audit-logs: WHERE tenant_id=? ORDER BY created_at DESC
  @@index([tenantId, createdAt(sort: Desc)])
  // ricerca per tipo azione: WHERE tenant_id=? AND azione=? ORDER BY created_at DESC
