// ─────────────────────────────────────────────────────────────────
// MAGIC LINK — accesso passwordless del cliente al portale (§23)
// ─────────────────────────────────────────────────────────────────
// Prima di questa tabella /auth/magic-login accettava qualunque stringa che iniziasse
// per `client_` e in cambio firmava un JWT con tenant ed email cablati: non c'era
// niente da verificare, perché i token non venivano persistiti da nessuna parte. Il
// rate limiting non c'entrava — non era un problema di brute force, non c'era nulla
// da indovinare.

model MagicLink {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  clienteId String    @map("cliente_id")
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // In tabella va lo SHA-256 del token, non il token: chi legge il database non deve
  // poter entrare al posto del cliente. SHA-256 e non scrypt perché il token ha già
  // 128 bit da crypto.randomBytes — scrypt difende dalle password indovinabili, e qui
  // non c'è niente da indovinare.
  tokenHash String    @unique @map("token_hash")
  scadenza  DateTime  @map("scadenza")
  // Indirizzo a cui il link è stato inviato. Serve all'audit — un credenziale di accesso
  // senza traccia di dove è finita non è verificabile — e dà un'email al JWT di sessione:
  // `Cliente` non ne ha una, e prima l'endpoint ne cablava una nel sorgente.
  email     String?   @map("email")
  // Primo utilizzo, per l'audit. Il link resta valido fino a scadenza: un cliente
  // riapre il proprio link più di una volta, e invalidarlo al primo accesso lo
  // chiuderebbe fuori. La revoca è la cancellazione della riga.
  usatoAt   DateTime? @map("usato_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("magic_link")
}

// ─────────────────────────────────────────────────────────────────
// CODICE OTP — secondo fattore della firma elettronica avanzata (§23bis)
// ─────────────────────────────────────────────────────────────────
// Prima i codici vivevano in una `Map` in memoria dentro otpService: bastava un restart
// di Railway — o il secondo processo di un deploy a due istanze — perché il cliente si
// trovasse "codice non valido" dopo averlo appena ricevuto. Un secondo fattore che non
// sopravvive al riavvio del server non è un secondo fattore.

model CodiceOtp {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  clienteId String   @map("cliente_id")
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // HMAC-SHA-256 del codice, non il codice: vedi `hashCodiceOtp` in src/util/jwt.ts.
  // Sei cifre sotto un hash veloce sono un milione di voci precalcolabili, quindi serve
  // un segreto che nel database non c'è.
  codiceHash String  @map("codice_hash")
  // whatsapp|email|telegram. Niente SMS: nessun provider è collegato, e un canale che
  // non spedisce ma compare nell'interfaccia è un modo di far fallire una firma.
  canale    String   @map("canale")
  // Recapito a cui il codice è stato effettivamente spedito, in chiaro e per intero.
  // L'audit di una firma deve poter dire dove è finito il fattore di autenticazione;
  // il mascheramento è una scelta di presentazione, si fa in risposta all'API.
  target    String   @map("target")
  // Il firmatario può indicare un recapito diverso da quello in anagrafica (§1.2). Quando
  // lo fa va a verbale: `targetAnagrafica` conserva il valore su scheda, e il sigillo dirà
  // che il fattore è stato consegnato a un recapito dichiarato in fase di firma. Senza
  // questi due campi la deviazione sarebbe invisibile a posteriori.
  targetDichiarato Boolean @default(false) @map("target_dichiarato")
  targetAnagrafica String? @map("target_anagrafica")
  // Cos'è che si sta autorizzando: engagement_letter|documento_vault|modulo_completato|addendum.
  // Un codice emesso per firmare un addendum non deve valere per un documento del Vault.
  ambito    String   @map("ambito")
  riferimentoId String? @map("riferimento_id")
  scadenza  DateTime @map("scadenza")
  // Tentativi di inserimento errati. Al terzo il codice muore: va richiesto un reinvio.
  tentativi Int      @default(0) @map("tentativi")
  // Reinvii già concessi, massimo 3, non prima di 60 secondi dall'ultimo (§1.5).
  reinvii   Int      @default(0) @map("reinvii")
  ultimoInvioAt DateTime @map("ultimo_invio_at")
  // IP reale del richiedente, null quando il proxy non lo espone: è il "non registrato"
  // dell'interfaccia. Un IP inventato in un verbale di firma è peggio di un IP assente.
  ipRichiesta String? @map("ip_richiesta")
  usatoAt   DateTime? @map("usato_at")
  createdAt DateTime @default(now()) @map("created_at")

  firme     FirmaElettronica[]

  // La verifica cerca l'ultimo codice vivo di quel cliente per quell'ambito.
  @@index([clienteId, ambito, scadenza])
  @@map("codice_otp")
}

// ─────────────────────────────────────────────────────────────────
// FIRMA ELETTRONICA — il sigillo, persistito (§23bis)
// ─────────────────────────────────────────────────────────────────
// Il sigillo eIDAS veniva costruito in memoria, restituito al browser e poi buttato: lo
// studio non aveva modo di dimostrare che una firma fosse stata apposta, perché in
// database non ne restava traccia. `engagement_letter.stato_firma = 'firmato'` dice che
// è successo, non cosa è successo — e non regge una contestazione.

model FirmaElettronica {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  clienteId String   @map("cliente_id")
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // Identificativo mostrato al firmatario e citato nel PDF. Unico perché è la chiave con
  // cui una firma viene richiamata da fuori.
  signatureId String @unique @map("signature_id")
  // fea_otp                → firma avanzata: lettura, OTP su canale scelto, grafometrica
  // manuale_scansionata    → il cliente scarica, firma a penna, ricarica il file (§1.3)
  // qualificata_esterna    → firmato con provider di firma digitale del cliente (§1.3)
  // Il tipo non è cosmetico: cambia il valore probatorio, e va scritto accanto alla firma.
  tipoFirma String  @map("tipo_firma")
  ambito    String   @map("ambito")
  riferimentoId String? @map("riferimento_id")
  documentoTitolo String @map("documento_titolo")
  firmatarioNome  String @map("firmatario_nome")
  firmatarioRuolo String? @map("firmatario_ruolo")
  // SHA-256 del contenuto firmato. È il legame fra sigillo e documento: senza, il sigillo
  // certifica un atto di volontà su un testo che nessuno può più identificare.
  documentoHash String @map("documento_hash")
  // Come è stato verificato il firmatario, in chiaro: "OTP via WhatsApp al +39…".
  // Prima diceva "OTP SMS/WhatsApp + Token Crittografico" a prescindere dal canale usato.
  canaleVerificato String? @map("canale_verificato")
  codiceOtpId String? @map("codice_otp_id")
  codiceOtp   CodiceOtp? @relation(fields: [codiceOtpId], references: [id])
  // Null quando l'IP non è disponibile. Il frontend scriveva '83.211.12.94 (eIDAS
  // Verificato)': un indirizzo cablato in un sigillo probatorio è una dichiarazione falsa.
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  // La grafometrica sta nella riga, come data URL, non in storage: `uploads/` su Railway
  // è effimero e il file sparirebbe al deploy successivo, lasciando un sigillo che
  // rimanda a un'immagine inesistente. Un PNG di firma sta in poche decine di KB.
  firmaGrafometricaPng String? @map("firma_grafometrica_png")
  // Per i due tipi non-FEA: il file caricato dal cliente e la sua impronta.
  fileFirmatoUrl  String? @map("file_firmato_url")
  fileFirmatoHash String? @map("file_firmato_hash")
  standard  String   @map("standard")
  firmatoAt DateTime @default(now()) @map("firmato_at")
  createdAt DateTime @default(now()) @map("created_at")
  // Punto 2 piano gap — il verbale di firma è un Documento (tipo 'verbale_firma') che
  // riassume l'evento in forma leggibile. Il collegamento è bidirezionale: dalla firma al
  // verbale generato, e dal verbale (che resta Documento) alla firma che lo ha prodotto.
  verbaleDocumentoId String?    @map("verbale_documento_id")
  verbaleDocumento   Documento? @relation(fields: [verbaleDocumentoId], references: [id])

  @@index([clienteId, ambito])
  @@map("firma_elettronica")
}

// ─────────────────────────────────────────────────────────────────
// PORTALE CLIENTE — §2.3, §2.5
// ─────────────────────────────────────────────────────────────────

// §2.3 — I dati fiscali (P.IVA, codice fiscale, IBAN, titolare effettivo…) il cliente li
// PROPONE e lo studio li CONFERMA: la riga del cliente cambia solo quando lo studio
// approva, così un errore di digitazione del cliente non finisce mai in anagrafica da solo.
enum StatoPropostaDati {
  in_attesa
  confermata
  rifiutata
}

model PropostaDatiFiscale {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  clienteId   String            @map("cliente_id")
  cliente     Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // piva|codiceFiscale|iban|titolareEffettivo|legaleRappresentante|ragioneSociale|sedeLegale
  campo       String            @map("campo")
  valoreAttuale  String?        @map("valore_attuale")
  valoreProposto String         @map("valore_proposto")
  notaCliente String?           @map("nota_cliente")
  notaStudio  String?           @map("nota_studio")
  stato       StatoPropostaDati @default(in_attesa)
  // Id di chi ha chiesto e di chi ha deciso: colonne semplici, non FK — l'utente può
  // essere disattivato e la proposta deve restare leggibile come storico.
  richiestoDaId String?         @map("richiesto_da_id")
  gestitoDaId   String?         @map("gestito_da_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // Una sola proposta pendente per campo: il cliente che ridigita sostituisce la sua
  // richiesta, non ne accumula.
  @@index([clienteId, campo, stato])
  @@map("proposta_dati_fiscale")
}

// §2.5 — L'addendum lo chiede il cliente con una richiesta libera; lo studio prepara il
// documento e la prestazione aggiuntiva. Prima la "cronologia addendum" viveva nel
// localStorage del browser del cliente: nessun altro la vedeva, e bastava cambiare
// dispositivo perché sparisse.
enum StatoRichiestaAddendum {
  richiesta
  in_preparazione
  pronta
  rifiutata
}

model RichiestaAddendum {
  id             String                 @id @default(uuid())
  tenantId       String                 @map("tenant_id")
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  clienteId      String                 @map("cliente_id")
  cliente        Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  progettoId     String                 @map("progetto_id")
  progetto       Progetto               @relation(fields: [progettoId], references: [id], onDelete: Cascade)
  testoRichiesta String                 @map("testo_richiesta")
  stato          StatoRichiestaAddendum @default(richiesta)
  // Cosa risponde lo studio: motivazione del rifiuto, oppure istruzioni e riferimento al
  // documento predisposto quando la richiesta è pronta.
  rispostaStudio String?                @map("risposta_studio")
  richiestoDaId  String?                @map("richiesto_da_id")
  gestitoDaId    String?                @map("gestito_da_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([progettoId, stato])
  @@map("richiesta_addendum")
}

// ─────────────────────────────────────────────────────────────────
// BLOCCO 6.1 — TIMESHEET SETTIMANALE (§ consuntivazione oraria)
// Una riga per operatore per giorno (chiave unica tenant+utente+giorno).
// L'operatore registra le ore in stato `bozza`; advisor/super_admin le
// approvano o le rifiutano. Solo le ore `approvato` alimentano il report
// "Ore per Operatore" (Blocco 5): le bozze sono auto-dichiarazioni non
// verificate e non entrano nella reportistica direzionale.
// ─────────────────────────────────────────────────────────────────

enum StatoTimesheet {
  bozza
  approvato
  rifiutato
}

model OraTimesheet {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  userId        String         @map("user_id")
  utente        User           @relation("TimesheetUtente", fields: [userId], references: [id], onDelete: Cascade)
  giorno        DateTime       @db.Date
  minuti        Int            // durata registrata nella giornata, in minuti
  progettoId    String?        @map("progetto_id")
  progetto      Progetto?      @relation(fields: [progettoId], references: [id], onDelete: SetNull)
  nota          String?
  stato         StatoTimesheet @default(bozza)
  approvatoDaId String?        @map("approvato_da_id")
  approvatoDa   User?          @relation("TimesheetApprovatore", fields: [approvatoDaId], references: [id], onDelete: SetNull)
  approvatoAt   DateTime?      @map("approvato_at")
  motivoRifiuto String?        @map("motivo_rifiuto")
  rifiutatoDaId String?        @map("rifiutato_da_id")
  rifiutatoDa   User?          @relation("TimesheetRifiutante", fields: [rifiutatoDaId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Una registrazione per membro per giorno: la griglia settimanale ha una
  // cella sola per incrocio, e l'upsert dell'API si appoggia a questa chiave.
  @@unique([tenantId, userId, giorno])
  @@index([tenantId, giorno])
  @@map("ora_timesheet")
}

