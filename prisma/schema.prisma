model ComunicazioneProgetto {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  progettoId   String   @map("progetto_id")
  progetto     Progetto @relation(fields: [progettoId], references: [id], onDelete: Cascade)
  canale       String // email | whatsapp | telegram | signal
  mittente     String
  destinatario String
  direzione    String   @default("entrata") // entrata | uscita
  testo        String
  allegatiJson String?  @map("allegati_json")
  externalId   String?  @map("external_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Indici aggiunti con l'audit 21/09/2026: la tabella non ne aveva NESSUNO. La lista del
  // fascicolo (`where progettoId order by createdAt`) faceva seq scan a ogni apertura chat, e
  // i webhook di stato WhatsApp cercano per external_id. Con la RLS ogni query è già cara: un
  // seq scan qui pesava molto più del previsto.
  @@index([tenantId, progettoId, createdAt], map: "idx_comunicazione_progetto_tenant_progetto_data")
  @@index([tenantId, externalId], map: "idx_comunicazione_progetto_tenant_external")
  @@map("comunicazione_progetto")
}

/// La chat di un canale agganciata a una pratica.
///
/// Nasce dal link per progetto (`t.me/<Bot>?start=<payload>`): chi lo tocca manda al bot un
/// `/start` con un payload firmato che dice a quale pratica appartiene quella chat. Da lì in poi i
/// messaggi di quella chat entrano in quel fascicolo **senza doverlo dedurre** dall'anagrafica.
///
/// Perché serve. L'instradamento precedente pretendeva che il `chat_id` fosse in una sola scheda
/// cliente **e** che quel cliente avesse un solo progetto aperto: due condizioni che nella realtà
/// degli studi cadono spesso (un cliente con due pratiche aperte, una persona che scrive per due
/// clienti). Quando cadevano, il messaggio non poteva entrare in nessun fascicolo e diventava un
/// avviso. Il collegamento esplicito toglie l'ambiguità invece di indovinare meglio.
///
/// La chiave unica è sulla **chat**, non sulla pratica: una chat scrive in una sola pratica, e un
/// secondo `/start` dalla stessa chat **sposta** il collegamento — è anche la via d'uscita se il
/// cliente ha toccato il link sbagliato. Più chat possono invece puntare alla stessa pratica.
///
/// `canale` esiste perché WhatsApp e Signal non hanno un deep link con payload, ma la tabella non
/// vada rifatta quando ne avranno uno: oggi solo Telegram la usa.
model CollegamentoChatProgetto {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  canale     String // telegram | whatsapp | signal
  chatId     String   @map("chat_id")
  clienteId  String   @map("cliente_id")
  progettoId String   @map("progetto_id")
  creatoAt   DateTime @default(now()) @map("creato_at")
  creatoDa   String   @default("link") @map("creato_da") // link | operatore

  // `onDelete: Cascade` sul progetto non è cosmetico: senza, un progetto collegato diventerebbe
  // non cancellabile con P2003 — cioè il guasto appena risolto su `eliminaProgetto`, per una via
  // nuova. Stesso precedente di `ComunicazioneProgetto.progetto`.
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  progetto Progetto @relation(fields: [progettoId], references: [id], onDelete: Cascade)

  @@unique([tenantId, canale, chatId])
  @@index([tenantId, progettoId])
  @@map("collegamento_chat_progetto")
}

/// Inbox idempotente dei provider: la chiave composta rende atomico il rifiuto dei replay.
model WebhookInbox {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
