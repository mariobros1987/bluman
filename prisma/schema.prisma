  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  titolo                String
  categoria             String    @default("contratto")
  descrizione           String?
  contenutoHtml         String    @map("contenuto_html") @db.Text
  // Piano firma §3.1 (Fase 2) — livello di valore legale (ses|fea|feq) scelto sul
  // template del Document Studio: POST /documenti/genera lo copia sul documento
  // generato, salvo override esplicita dell'operatore nella richiesta.
  livelloFirmaRichiesto String    @default("ses") @map("livello_firma_richiesto")
  // §41 — Cartella template dello studio: stato di revisione del modello.
  //
  // Serve a rispondere alla domanda che l'operatore si pone davanti a un modello: «questo
  // testo l'ha già riletto qualcuno?». Prima non c'era modo di saperlo, e un modello appena
  // abbozzato e uno approvato dal titolare erano indistinguibili nell'elenco.
  //
  // `stato_revisione`: bozza | in_revisione | approvato (l'insieme sta in
  // `src/services/revisioneModello.ts`, che è anche l'unico posto che decide i passaggi).
  // `versione` sale quando il TESTO di un modello approvato cambia: un'approvazione che
  // resta appesa a un contenuto diverso da quello approvato non attesta niente.
  statoRevisione        String    @default("bozza") @map("stato_revisione")
  versione              Int       @default(1)
  noteRevisione         String?   @map("note_revisione")
  // Chi ha deciso lo stato, denormalizzato come in `audit_log`: il nome sulla riga resta
  // leggibile anche se l'utenza viene disattivata o rinominata.
  revisionatoDaUserId   String?   @map("revisionato_da_user_id")
  revisionatoDaNome     String?   @map("revisionato_da_nome")
  revisionatoAt         DateTime? @map("revisionato_at")
  // Archiviare non è eliminare: il modello esce dagli elenchi operativi e resta a database
  // (i documenti già generati sono copie congelate e non ne dipendono).
  archiviatoAt          DateTime? @map("archiviato_at")
  // Se il modello nasce adottando uno dei modelli di serie del codice, qui resta l'id di
  // quel modello: l'adozione diventa idempotente e la cartella non mostra due volte la
  // stessa carta. Nullo per i modelli scritti dallo studio.
  riferimentoSerie      String?   @map("riferimento_serie")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, riferimentoSerie], map: "modello_documento_custom_tenant_serie_key")
  @@map("modello_documento_custom")
}

// ─────────────────────────────────────────────────────────────────
// MAGIC LINK — accesso passwordless del cliente al portale (§23)
// ─────────────────────────────────────────────────────────────────
// Prima di questa tabella /auth/magic-login accettava qualunque stringa che iniziasse
// per `client_` e in cambio firmava un JWT con tenant ed email cablati: non c'era
// niente da verificare, perché i token non venivano persistiti da nessuna parte. Il
// rate limiting non c'entrava — non era un problema di brute force, non c'era nulla
// da indovinare.

model MagicLink {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  clienteId String    @map("cliente_id")
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // In tabella va lo SHA-256 del token, non il token: chi legge il database non deve
  // poter entrare al posto del cliente. SHA-256 e non scrypt perché il token ha già
  // 128 bit da crypto.randomBytes — scrypt difende dalle password indovinabili, e qui
  // non c'è niente da indovinare.
  tokenHash String    @unique @map("token_hash")
  scadenza  DateTime  @map("scadenza")
  // Indirizzo a cui il link è stato inviato. Serve all'audit — un credenziale di accesso
  // senza traccia di dove è finita non è verificabile — e dà un'email al JWT di sessione:
  // `Cliente` non ne ha una, e prima l'endpoint ne cablava una nel sorgente.
  email     String?   @map("email")
  // Momento del consumo. Il link è monouso: il login lo valorizza con un update
  // condizionale atomico (`usato_at IS NULL`) prima di emettere la sessione.
  usatoAt   DateTime? @map("usato_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("magic_link")
}

// ─────────────────────────────────────────────────────────────────
// CODICE OTP — secondo fattore della firma elettronica avanzata (§23bis)
// ─────────────────────────────────────────────────────────────────
// Prima i codici vivevano in una `Map` in memoria dentro otpService: bastava un restart
// di Railway — o il secondo processo di un deploy a due istanze — perché il cliente si
// trovasse "codice non valido" dopo averlo appena ricevuto. Un secondo fattore che non
// sopravvive al riavvio del server non è un secondo fattore.

model CodiceOtp {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  clienteId        String    @map("cliente_id")
  cliente          Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // HMAC-SHA-256 del codice, non il codice: vedi `hashCodiceOtp` in src/util/jwt.ts.
  // Sei cifre sotto un hash veloce sono un milione di voci precalcolabili, quindi serve
  // un segreto che nel database non c'è.
  codiceHash       String    @map("codice_hash")
  // whatsapp|email|telegram. Niente SMS: nessun provider è collegato, e un canale che
  // non spedisce ma compare nell'interfaccia è un modo di far fallire una firma.
  canale           String    @map("canale")
  // Recapito a cui il codice è stato effettivamente spedito, in chiaro e per intero.
  // L'audit di una firma deve poter dire dove è finito il fattore di autenticazione;
  // il mascheramento è una scelta di presentazione, si fa in risposta all'API.
  target           String    @map("target")
  // Il firmatario può indicare un recapito diverso da quello in anagrafica (§1.2). Quando
  // lo fa va a verbale: `targetAnagrafica` conserva il valore su scheda, e il sigillo dirà
  // che il fattore è stato consegnato a un recapito dichiarato in fase di firma. Senza
  // questi due campi la deviazione sarebbe invisibile a posteriori.
  targetDichiarato Boolean   @default(false) @map("target_dichiarato")
  targetAnagrafica String?   @map("target_anagrafica")
  // Cos'è che si sta autorizzando: engagement_letter|documento_vault|modulo_completato|addendum.
  // Un codice emesso per firmare un addendum non deve valere per un documento del Vault.
  ambito           String    @map("ambito")
  riferimentoId    String?   @map("riferimento_id")
  scadenza         DateTime  @map("scadenza")
  // Tentativi di inserimento errati. Al terzo il codice muore: va richiesto un reinvio.
  tentativi        Int       @default(0) @map("tentativi")
  // Reinvii già concessi, massimo 3, non prima di 60 secondi dall'ultimo (§1.5).
  reinvii          Int       @default(0) @map("reinvii")
  ultimoInvioAt    DateTime  @map("ultimo_invio_at")
  // IP reale del richiedente, null quando il proxy non lo espone: è il "non registrato"
  // dell'interfaccia. Un IP inventato in un verbale di firma è peggio di un IP assente.
  ipRichiesta      String?   @map("ip_richiesta")
  usatoAt          DateTime? @map("usato_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  firme FirmaElettronica[]

  // La verifica cerca l'ultimo codice vivo di quel cliente per quell'ambito.
  @@index([clienteId, ambito, scadenza])
  @@map("codice_otp")
}

// ─────────────────────────────────────────────────────────────────
// FIRMA ELETTRONICA — il sigillo, persistito (§23bis)
// ─────────────────────────────────────────────────────────────────
// Il sigillo eIDAS veniva costruito in memoria, restituito al browser e poi buttato: lo
// studio non aveva modo di dimostrare che una firma fosse stata apposta, perché in
// database non ne restava traccia. `engagement_letter.stato_firma = 'firmato'` dice che
// è successo, non cosa è successo — e non regge una contestazione.

model FirmaElettronica {
  id                    String     @id @default(uuid())
  tenantId              String     @map("tenant_id")
  tenant                Tenant     @relation(fields: [tenantId], references: [id])
  clienteId             String     @map("cliente_id")
  cliente               Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // Identificativo mostrato al firmatario e citato nel PDF. Unico perché è la chiave con
  // cui una firma viene richiamata da fuori.
  signatureId           String     @unique @map("signature_id")
  // fea_otp                → firma avanzata: lettura, OTP su canale scelto, grafometrica
  // manuale_scansionata    → il cliente scarica, firma a penna, ricarica il file (§1.3)
  // qualificata_esterna    → firmato con provider di firma digitale del cliente (§1.3)
  // Il tipo non è cosmetico: cambia il valore probatorio, e va scritto accanto alla firma.
  tipoFirma             String     @map("tipo_firma")
  // Piano firma §3.1 (Fase 2) — valore legale EFFETTIVO della firma apposta (ses|fea|feq).
  // `tipoFirma` dice il meccanismo, questo dice la legge: lo scrivono le rotte di firma al
  // momento dell'apposizione. Le righe già registrate non si toccano: è un atto probatorio.
  valoreLegale          String     @default("ses") @map("valore_legale")
  ambito                String     @map("ambito")
  riferimentoId         String?    @map("riferimento_id")
  documentoTitolo       String     @map("documento_titolo")
  firmatarioNome        String     @map("firmatario_nome")
  firmatarioRuolo       String?    @map("firmatario_ruolo")
  // SHA-256 del contenuto firmato. È il legame fra sigillo e documento: senza, il sigillo
  // certifica un atto di volontà su un testo che nessuno può più identificare.
  documentoHash         String     @map("documento_hash")
  // Come è stato verificato il firmatario, in chiaro: "OTP via WhatsApp al +39…".
  // Prima diceva "OTP SMS/WhatsApp + Token Crittografico" a prescindere dal canale usato.
  canaleVerificato      String?    @map("canale_verificato")
  codiceOtpId           String?    @map("codice_otp_id")
  codiceOtp             CodiceOtp? @relation(fields: [codiceOtpId], references: [id])
  // Null quando l'IP non è disponibile. Il frontend scriveva '83.211.12.94 (eIDAS
  // Verificato)': un indirizzo cablato in un sigillo probatorio è una dichiarazione falsa.
  ipAddress             String?    @map("ip_address")
  userAgent             String?    @map("user_agent")
  // Fase 3 FEA (misura 3) — certificato di sessione: l'id della sessione portale e il
  // momento del login entrano nel payload del digest del sigillo. Null quando la firma
  // non proviene dal flusso FEA o la sessione non li porta.
  sessionId             String?    @map("session_id")
  loginAt               DateTime?  @map("login_at")
  // Fase 3 FEA (misura 1) — identificazione: hash e tipo del documento di riconoscimento
  // del firmatario caricato una tantum. Raccomandato (non obbligatorio) per FEA: quando
  // presente, l'hash entra nel digest del sigillo.
  docRiconoscimentoHash String?    @map("doc_riconoscimento_hash")
  docRiconoscimentoTipo String?    @map("doc_riconoscimento_tipo")
  // La grafometrica sta nella riga, come data URL, non in storage: `uploads/` su Railway
  // è effimero e il file sparirebbe al deploy successivo, lasciando un sigillo che
  // rimanda a un'immagine inesistente. Un PNG di firma sta in poche decine di KB.
  firmaGrafometricaPng  String?    @map("firma_grafometrica_png")
  // Per i due tipi non-FEA: il file caricato dal cliente e la sua impronta.
  fileFirmatoUrl        String?    @map("file_firmato_url")
  fileFirmatoHash       String?    @map("file_firmato_hash")
  standard              String     @map("standard")
  firmatoAt             DateTime   @default(now()) @map("firmato_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  // Punto 2 piano gap — il verbale di firma è un Documento (tipo 'verbale_firma') che
  // riassume l'evento in forma leggibile. Il collegamento è bidirezionale: dalla firma al
  // verbale generato, e dal verbale (che resta Documento) alla firma che lo ha prodotto.
  verbaleDocumentoId    String?    @map("verbale_documento_id")
  verbaleDocumento      Documento? @relation(fields: [verbaleDocumentoId], references: [id])

  @@index([clienteId, ambito])
  @@map("firma_elettronica")
}

// ─────────────────────────────────────────────────────────────────
// PORTALE CLIENTE — §2.3, §2.5
// ─────────────────────────────────────────────────────────────────

// §2.3 — I dati fiscali (P.IVA, codice fiscale, IBAN, titolare effettivo…) il cliente li
// PROPONE e lo studio li CONFERMA: la riga del cliente cambia solo quando lo studio
// approva, così un errore di digitazione del cliente non finisce mai in anagrafica da solo.
enum StatoPropostaDati {
  in_attesa
  confermata
  rifiutata
}

model PropostaDatiFiscale {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  clienteId      String            @map("cliente_id")
  cliente        Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // piva|codiceFiscale|iban|titolareEffettivo|legaleRappresentante|ragioneSociale|sedeLegale
  campo          String            @map("campo")
  valoreAttuale  String?           @map("valore_attuale")
  valoreProposto String            @map("valore_proposto")
  notaCliente    String?           @map("nota_cliente")
  notaStudio     String?           @map("nota_studio")
  stato          StatoPropostaDati @default(in_attesa)
  // Id di chi ha chiesto e di chi ha deciso: colonne semplici, non FK — l'utente può
  // essere disattivato e la proposta deve restare leggibile come storico.
  richiestoDaId  String?           @map("richiesto_da_id")
  gestitoDaId    String?           @map("gestito_da_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  // Una sola proposta pendente per campo: il cliente che ridigita sostituisce la sua
  // richiesta, non ne accumula.
  @@index([clienteId, campo, stato])
  @@map("proposta_dati_fiscale")
}

// §2.5 — L'addendum lo chiede il cliente con una richiesta libera; lo studio prepara il
// documento e la prestazione aggiuntiva. Prima la "cronologia addendum" viveva nel
// localStorage del browser del cliente: nessun altro la vedeva, e bastava cambiare
// dispositivo perché sparisse.
enum StatoRichiestaAddendum {
  richiesta
  in_preparazione
  pronta
  rifiutata
}

model RichiestaAddendum {
  id             String                 @id @default(uuid())
  tenantId       String                 @map("tenant_id")
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  clienteId      String                 @map("cliente_id")
  cliente        Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  progettoId     String                 @map("progetto_id")
  progetto       Progetto               @relation(fields: [progettoId], references: [id], onDelete: Cascade)
  testoRichiesta String                 @map("testo_richiesta")
  stato          StatoRichiestaAddendum @default(richiesta)
  // Cosa risponde lo studio: motivazione del rifiuto, oppure istruzioni e riferimento al
  // documento predisposto quando la richiesta è pronta.
  rispostaStudio String?                @map("risposta_studio")
  richiestoDaId  String?                @map("richiesto_da_id")
  gestitoDaId    String?                @map("gestito_da_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([progettoId, stato])
  @@map("richiesta_addendum")
}

// ─────────────────────────────────────────────────────────────────
// BLOCCO 6.1 — TIMESHEET SETTIMANALE (§ consuntivazione oraria)
// Una riga per operatore per giorno (chiave unica tenant+utente+giorno).
// L'operatore registra le ore in stato `bozza`; advisor/super_admin le
// approvano o le rifiutano. Solo le ore `approvato` alimentano il report
// "Ore per Operatore" (Blocco 5): le bozze sono auto-dichiarazioni non
// verificate e non entrano nella reportistica direzionale.
// ─────────────────────────────────────────────────────────────────

enum StatoTimesheet {
  bozza
  approvato
  rifiutato
}

model OraTimesheet {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  userId        String         @map("user_id")
  utente        User           @relation("TimesheetUtente", fields: [userId], references: [id], onDelete: Cascade)
  giorno        DateTime       @db.Date
  minuti        Int // durata registrata nella giornata, in minuti
  progettoId    String?        @map("progetto_id")
  progetto      Progetto?      @relation(fields: [progettoId], references: [id], onDelete: SetNull)
  nota          String?
  stato         StatoTimesheet @default(bozza)
  approvatoDaId String?        @map("approvato_da_id")
  approvatoDa   User?          @relation("TimesheetApprovatore", fields: [approvatoDaId], references: [id], onDelete: SetNull)
  approvatoAt   DateTime?      @map("approvato_at")
  motivoRifiuto String?        @map("motivo_rifiuto")
  rifiutatoDaId String?        @map("rifiutato_da_id")
  rifiutatoDa   User?          @relation("TimesheetRifiutante", fields: [rifiutatoDaId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Una registrazione per membro per giorno: la griglia settimanale ha una
  // cella sola per incrocio, e l'upsert dell'API si appoggia a questa chiave.
  @@unique([tenantId, userId, giorno])
  @@index([tenantId, giorno])
  @@map("ora_timesheet")
}

// ─────────────────────────────────────────────────────────────────
// NOTE OPERATIVE — da fare a mano dopo `prisma migrate dev`, Prisma non le genera:
//
// 1. Row-Level Security su tenant_id (§14):
//      NON si scrive una policy per tabella a mano. La sezione 3 di
//      supabase/migrations/20260819_rls_effettiva.sql cicla per introspezione su ogni
//      tabella che abbia una colonna `tenant_id` NOT NULL e le applica ENABLE + FORCE
//      ROW LEVEL SECURITY più la policy `isolamento_tenant`. Dopo aver aggiunto un
//      modello con `tenantId`, la procedura è rieseguire quel blocco (o la migrazione
//      dedicata che lo richiama) e controllare la query di verifica in fondo al file,
//      che elenca le tabelle raggiungibili da `bluman_app` rimaste senza policy.
//      Il super_admin usa un ruolo DB separato che bypassa la policy (§2bis).
//
// 2. CHECK "esattamente una risorsa valorizzata" su accesso_risorsa (§19):
//      ALTER TABLE accesso_risorsa ADD CONSTRAINT chk_una_risorsa CHECK (
//        (progetto_id IS NOT NULL)::int +
//        (modulo_progetto_id IS NOT NULL)::int +
//        (microvoce_progetto_id IS NOT NULL)::int = 1
//      );
//
// 3. Verifica anti-ciclo su modulo_dipendenza_template / modulo_progetto_dipendenza (§7ter):
//      applicativa, non un vincolo SQL — va implementata nel service layer
//      prima dell'INSERT (percorso DFS sul grafo esistente + candidato).
// ─────────────────────────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════════
// MODULO KYC/AML §5.5 — Fase 5.5.1 (modello dati). Spec: bluman-kyc-aml-spec-tecnica.md
// FascicoloKyc e la fonte di verita del processo; i campi legacy su Cliente (rischioAml,
// ubo, dataKyc, fontePatrimonio) restano come proiezione di sola lettura (decisione titolare).
// Chiavi @default(uuid()) come tutto lo schema (non cuid come nella bozza della spec).
// ═══════════════════════════════════════════════════════════════════

enum StatoKyc {
  bozza
  in_attesa_revisione // legacy v0.1 — non più scritto (rimappato a in_attesa_approvazione)
  approvato
  respinto
  scaduto // legacy v0.1 — non più scritto (rimappato a sospeso)
  // v0.2 (spec §8) — ciclo di vita completo della pratica:
  in_raccolta
  in_verifica
  in_attesa_approvazione
  sospeso
  in_revisione
  chiuso
}

enum LivelloVerifica {
  semplificata
  ordinaria
  rafforzata
}

enum LivelloRischio {
  basso
  medio
  alto
}

enum FonteUbo {
  registro_camerale
  autodichiarazione
}

enum TipoDocumentoKyc {
  documento_identita
  documento_ubo
  visura_camerale
  autodichiarazione_fondi
  esito_screening_pep
  esito_screening_liste
  altro
}

model FascicoloKyc {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // v0.2 (spec §7): la pratica (KycCase) ha un soggetto (Party) e un eventuale incarico collegato.
  // Nullable in K1: il soggetto si crea al primo salvataggio, il gating sull'incarico arriva in K4.
  soggettoId         String?      @map("soggetto_id")
  soggetto           SoggettoKyc? @relation(fields: [soggettoId], references: [id], onDelete: SetNull)
  progettoId         String?      @map("progetto_id")
  responsabileUserId String?      @map("responsabile_user_id")

  stato            StatoKyc        @default(bozza)
  livelloVerifica  LivelloVerifica @default(ordinaria) @map("livello_verifica")
  rischioCalcolato LivelloRischio  @default(basso) @map("rischio_calcolato")
  punteggioRischio Int             @default(0) @map("punteggio_rischio")

  pep            Boolean @default(false)
  paeseRischio   String? @map("paese_rischio")
  paeseResidenza String? @map("paese_residenza")

  fonteVerificaUbo FonteUbo  @default(autodichiarazione) @map("fonte_verifica_ubo")
  uboVerificatoIl  DateTime? @map("ubo_verificato_il")

  dataVerifica   DateTime? @map("data_verifica")
  dataScadenza   DateTime? @map("data_scadenza")
  approvatoDa    String?   @map("approvato_da")
  approvatoIl    DateTime? @map("approvato_il")
  noteCompliance String?   @map("note_compliance")

  soglieOperazione Decimal? @map("soglie_operazione")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documenti   DocumentoKyc[]
  storico     StoricoFascicoloKyc[]
  overrideLog OverrideKyc[]

  // K2 — titolare effettivo, catena di controllo, deposito al registro.
  titolariEffettivi  TitolareEffettivo[]
  legamiControllo    LegameControllo[]
  depositiRegistroTe DepositoRegistroTe[]
  riskAssessments    RiskAssessment[]
  screenings         ScreeningKyc[]
  anomalie           AnomaliaKyc[]

  @@index([tenantId, clienteId])
  @@index([tenantId, stato, dataScadenza])
  @@map("fascicolo_kyc")
}

model StoricoFascicoloKyc {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  fascicoloId     String       @map("fascicolo_id")
  fascicolo       FascicoloKyc @relation(fields: [fascicoloId], references: [id], onDelete: Cascade)
  statoPrecedente StatoKyc?    @map("stato_precedente")
  statoNuovo      StatoKyc     @map("stato_nuovo")
  attoreUserId    String       @map("attore_user_id")
  motivazione     String?
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([tenantId, fascicoloId])
  @@map("storico_fascicolo_kyc")
}

model OverrideKyc {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  fascicoloId     String       @map("fascicolo_id")
  fascicolo       FascicoloKyc @relation(fields: [fascicoloId], references: [id], onDelete: Cascade)
  attoreUserId    String       @map("attore_user_id")
  azioneSbloccata String       @map("azione_sbloccata")
  motivazione     String
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([tenantId, fascicoloId])
  @@map("override_kyc")
}

model DocumentoKyc {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  fascicoloId String           @map("fascicolo_id")
  fascicolo   FascicoloKyc     @relation(fields: [fascicoloId], references: [id], onDelete: Cascade)
  tipo        TipoDocumentoKyc
  fonte       FonteUbo         @default(autodichiarazione)
  urlStorage  String           @map("url_storage")
  hashSha256  String?          @map("hash_sha256")
  caricatoDa  String           @map("caricato_da")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([tenantId, fascicoloId])
  @@map("documento_kyc")
}

// ═══════════════════════════════════════════════════════════════════
// KYC/AML Fase K1 (Malta, spec v0.2 §7) — anagrafica soggetti, documenti, rappresentanza.
// Entità nuove; la pratica resta `FascicoloKyc` (è il KycCase della spec, nome IT coerente col repo).
// ═══════════════════════════════════════════════════════════════════

enum TipoSoggettoKyc {
  persona_fisica
  persona_giuridica
}

/// Soggetto (Party, spec §7) di una pratica KYC. In K1 corrisponde al cliente (clienteId valorizzato);
/// da K2 rappresenta anche titolari effettivi e rappresentanti (clienteId null).
model SoggettoKyc {
  id             String          @id @default(uuid())
  tenantId       String          @map("tenant_id")
  tipo           TipoSoggettoKyc @default(persona_fisica)
  clienteId      String?         @map("cliente_id")
  cliente        Cliente?        @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  denominazione  String
  codiceFiscale  String?         @map("codice_fiscale")
  partitaIva     String?         @map("partita_iva")
  luogoNascita   String?         @map("luogo_nascita")
  dataNascita    String?         @map("data_nascita")
  paeseResidenza String?         @map("paese_residenza")
  indirizzo      String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  fascicoli             FascicoloKyc[]
  documentiIdentita     DocumentoIdentita[]
  rappresentanzeAttive  Rappresentanza[]    @relation("rappresentante")
  rappresentanzePassive Rappresentanza[]    @relation("rappresentato")

  // K2 — questo soggetto come titolare effettivo, e come nodo (owner/owned) della catena di controllo.
  titolaritaEffettive TitolareEffettivo[]
  controlloDa         LegameControllo[]   @relation("controllo_da")
  controlloA          LegameControllo[]   @relation("controllo_a")

  @@index([tenantId, clienteId])
  @@map("soggetto_kyc")
}

/// Documento d'identità (spec §7): file cifrato a riposo (riuso storageService), esito verifica.
model DocumentoIdentita {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  soggettoId    String      @map("soggetto_id")
  soggetto      SoggettoKyc @relation(fields: [soggettoId], references: [id], onDelete: Cascade)
  tipo          String // carta_identita | passaporto | permesso_soggiorno | altro
  numero        String?
  emittente     String?
  scadenza      DateTime?
  urlStorage    String?     @map("url_storage")
  hashSha256    String?     @map("hash_sha256")
  esitoVerifica String?     @map("esito_verifica")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([tenantId, soggettoId])
  @@map("documento_identita")
}

/// Rappresentanza (spec §7): rappresentante ↔ rappresentato, poteri, fonte. Predispone la catena K2.
model Rappresentanza {
  id               String      @id @default(uuid())
  tenantId         String      @map("tenant_id")
  rappresentanteId String      @map("rappresentante_id")
  rappresentante   SoggettoKyc @relation("rappresentante", fields: [rappresentanteId], references: [id], onDelete: Cascade)
  rappresentatoId  String      @map("rappresentato_id")
  rappresentato    SoggettoKyc @relation("rappresentato", fields: [rappresentatoId], references: [id], onDelete: Cascade)
  poteri           String?
  fonte            String?
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([tenantId, rappresentanteId])
  @@index([tenantId, rappresentatoId])
  @@map("rappresentanza")
}

// ═══════════════════════════════════════════════════════════════════
// KYC/AML Fase K0 (Malta, spec v0.2) — la fondazione configurabile.
// Le regole cambiano per CONFIGURAZIONE, non per codice: pacchetto giurisdizione + profilo.
// ═══════════════════════════════════════════════════════════════════

/// Impostazioni di compliance per tenant (una riga per studio). Finché regulatoryProfile o
/// mlroUserId mancano, il tenant è in «modalità bozza» e nessun incarico passa in esecuzione.
model TenantComplianceSettings {
  id                      String   @id @default(uuid())
  tenantId                String   @unique @map("tenant_id")
  jurisdictionPack        String   @default("MT") @map("jurisdiction_pack") // MT | IT
  regulatoryProfile       String?  @map("regulatory_profile") // CSP_MFSA | ALTRO_SOGGETTO_OBBLIGATO | null
  otherSubjectCategory    String?  @map("other_subject_category")
  retentionYears          Int      @default(5) @map("retention_years")
  mlroUserId              String?  @map("mlro_user_id")
  reportingChannel        String   @default("goAML") @map("reporting_channel")
  screeningProvider       String   @default("MANUALE") @map("screening_provider")
  featureFlags            Json?    @map("feature_flags")
  // K2 — configurazione titolare effettivo (regole per configurazione, spec §3.2). Default marcati
  // [da verificare] rispetto alle Implementing Procedures maltesi finché il titolare non li conferma.
  sogliaTitolareEffettivo Int      @default(25) @map("soglia_titolare_effettivo") // % titolarità effettiva
  allarmeVariazioniTe     Boolean  @default(false) @map("allarme_variazioni_te") // caso+scadenza 14gg sulle variazioni
  gestioneRegistroTe      Boolean  @default(false) @map("gestione_registro_te") // lo studio coordina i depositi al registro TE
  versione                Int      @default(1)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("tenant_compliance_settings")
}

/// Evento di compliance immutabile e a catena hash (tamper-evident): ogni cambio di settings o
/// di stato di un caso vi lascia una riga. Append-only lato applicativo.
model ComplianceEvent {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tipo           String
  attoreUserId   String?  @map("attore_user_id")
  payload        Json?
  hashPrecedente String?  @map("hash_precedente")
  hash           String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("compliance_event")
}

// ═══════════════════════════════════════════════════════════════════
// KYC/AML Fase K2 (Malta, spec §7) — titolare effettivo, catena di controllo, deposito al registro.
// ═══════════════════════════════════════════════════════════════════

/// Titolare effettivo del cliente individuato in una pratica: chi è (SoggettoKyc), con quale
/// criterio, quota e fonte. Più TE per fascicolo.
model TitolareEffettivo {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  fascicoloId  String       @map("fascicolo_id")
  fascicolo    FascicoloKyc @relation(fields: [fascicoloId], references: [id], onDelete: Cascade)
  soggettoId   String       @map("soggetto_id")
  soggetto     SoggettoKyc  @relation(fields: [soggettoId], references: [id], onDelete: Cascade)
  criterio     String // proprieta | controllo | altro
  percentuale  Decimal?
  fonte        FonteUbo     @default(autodichiarazione)
  dataVerifica DateTime?    @map("data_verifica")
  note         String?
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([tenantId, fascicoloId])
  @@map("titolare_effettivo")
}

/// Arco della catena di controllo: `da` possiede/controlla `a` per una quota. Ricostruisce chi
/// controlla in cima quando ci sono holding/strutture intermedie.
model LegameControllo {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  fascicoloId String       @map("fascicolo_id")
  fascicolo   FascicoloKyc @relation(fields: [fascicoloId], references: [id], onDelete: Cascade)
  daId        String       @map("da_soggetto_id")
  da          SoggettoKyc  @relation("controllo_da", fields: [daId], references: [id], onDelete: Cascade)
  aId         String       @map("a_soggetto_id")
  a           SoggettoKyc  @relation("controllo_a", fields: [aId], references: [id], onDelete: Cascade)
  percentuale Decimal?
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([tenantId, fascicoloId])
  @@map("legame_controllo")
}

// K2_DEPOSITO_PLACEHOLDER

/// Stato della comunicazione al registro dei titolari effettivi (Malta Business Registry), con
/// scadenza a 14 gg sulle variazioni. Acquisizione manuale (il registro non è ad accesso automatico).
model DepositoRegistroTe {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  fascicoloId  String       @map("fascicolo_id")
  fascicolo    FascicoloKyc @relation(fields: [fascicoloId], references: [id], onDelete: Cascade)
  stato        String       @default("da_depositare") // da_depositare | depositato | in_ritardo
  dataDeposito DateTime?    @map("data_deposito")
  scadenza     DateTime?
  riferimento  String?
  note         String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([tenantId, fascicoloId])
  @@map("deposito_registro_te")
}

// ═══════════════════════════════════════════════════════════════════
// KYC/AML Fase K3 (Malta, spec §6) — valutazione del rischio a 4 pilastri.
// NON un punteggio unico: cliente/geografia/prodotto/canale, ognuno con livello e motivazione.
// Livello complessivo = «il più alto vince» (worst-case). Versionata, mai sovrascritta.
// ═══════════════════════════════════════════════════════════════════
model RiskAssessment {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  fascicoloId String       @map("fascicolo_id")
  fascicolo   FascicoloKyc @relation(fields: [fascicoloId], references: [id], onDelete: Cascade)

  clienteLivello       LivelloRischio @default(basso) @map("cliente_livello")
  clienteMotivazione   String?        @map("cliente_motivazione")
  geografiaLivello     LivelloRischio @default(basso) @map("geografia_livello")
  geografiaMotivazione String?        @map("geografia_motivazione")
  prodottoLivello      LivelloRischio @default(basso) @map("prodotto_livello")
  prodottoMotivazione  String?        @map("prodotto_motivazione")
  canaleLivello        LivelloRischio @default(basso) @map("canale_livello")
  canaleMotivazione    String?        @map("canale_motivazione")

  livelloComplessivo     LivelloRischio @default(basso) @map("livello_complessivo")
  motivazioneComplessiva String?        @map("motivazione_complessiva")
  versione               Int            @default(1)
  prossimaRevisione      DateTime?      @map("prossima_revisione")
  attoreUserId           String?        @map("attore_user_id")
  createdAt              DateTime       @default(now()) @map("created_at")

  @@index([tenantId, fascicoloId])
  @@map("risk_assessment")
}

enum TipoScreening {
  sanzioni
  pep
  media_negativi
}

enum EsitoScreening {
  nessun_match
  match_da_valutare
  match_confermato
  falso_positivo
}

// ═══════════════════════════════════════════════════════════════════
// KYC/AML Fase K5 (Malta, spec §5.1.5 / §7 / §8.4 / §10) — screening PEP / sanzioni / media negativi.
// Processo MANUALE (screeningProvider default "MANUALE", spec §10): l'operatore registra l'esito con
// allegato. Un match NON risolto (match_da_valutare | match_confermato) blocca l'approvazione della
// pratica (§8.4). Una riga per `tipo`: un match PEP si risolve indipendentemente da uno sanzioni.
// ═══════════════════════════════════════════════════════════════════
model ScreeningKyc {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  fascicoloId String       @map("fascicolo_id")
  fascicolo   FascicoloKyc @relation(fields: [fascicoloId], references: [id], onDelete: Cascade)
  soggettoId  String?      @map("soggetto_id")

  tipo          TipoScreening
  esito         EsitoScreening @default(nessun_match)
  fonte         String?
  dataScreening DateTime       @default(now()) @map("data_screening")
  matchDettagli String?        @map("match_dettagli")
  allegatoUrl   String?        @map("allegato_url")

  notaRisoluzione String?   @map("nota_risoluzione")
  risoltoDa       String?   @map("risolto_da")
  risoltoIl       DateTime? @map("risolto_il")

  attoreUserId String?  @map("attore_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, fascicoloId])
  @@map("screening_kyc")
}

enum TipoAnomaliaKyc {
  match_sanzioni
  match_pep
  operazione_sospetta
  documento_incongruente
  rischio_elevato
  altro
}

enum StatoAnomaliaKyc {
  aperta
  in_valutazione
  chiusa_nessuna_azione
  monitoraggio_rafforzato
  segnalata_fiau
  rapporto_chiuso
}

enum DecisioneMlro {
  nessuna_azione
  monitoraggio_rafforzato
  segnalazione_fiau
  chiusura_rapporto
}

// ═══════════════════════════════════════════════════════════════════
// KYC/AML Fase K8a (Malta, spec §5.3) — anomalie / segnalazioni interne e decisioni dell'MLRO.
// L'anomalia è un candidato SAR interno; la decisione MLRO è append-only (MlroDecisionLog) e ogni
// passo emette un ComplianceEvent. L'export goAML (K8b) è una fase successiva (serve l'XSD FIAU).
// ═══════════════════════════════════════════════════════════════════
model AnomaliaKyc {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  fascicoloId String           @map("fascicolo_id")
  fascicolo   FascicoloKyc     @relation(fields: [fascicoloId], references: [id], onDelete: Cascade)
  tipo        TipoAnomaliaKyc
  descrizione String
  stato       StatoAnomaliaKyc @default(aperta)
  rilevataDa  String?          @map("rilevata_da")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  decisioni MlroDecisionLog[]

  @@index([tenantId, fascicoloId])
  @@map("anomalia_kyc")
}

/// Registro append-only delle decisioni dell'MLRO su un'anomalia (spec §5.3). Non si aggiorna né si
/// cancella: ogni decisione è un anello, la più recente determina lo stato dell'anomalia.
model MlroDecisionLog {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  anomaliaId  String        @map("anomalia_id")
  anomalia    AnomaliaKyc   @relation(fields: [anomaliaId], references: [id], onDelete: Cascade)
  decisione   DecisioneMlro
  motivazione String
  decisaDa    String?       @map("decisa_da")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([tenantId, anomaliaId])
  @@map("mlro_decision_log")
}
