// BluMan — Schema database
// Fonte: BluMan_specifica_di_sviluppo_v2.3.docx §14, con estensioni §19 (accesso_risorsa a 3 FK),
// §26 (campi SDI su fattura) e §28 (sicurezza upload su documento) incluse fin dall'inizio —
// vedi piano di sviluppo, Fase 1: evitare una migrazione dolorosa a metà sviluppo.
//
// Row-Level Security su tenant_id: attiva. Le policy stanno in
// supabase/migrations/20260819_rls_effettiva.sql e si applicano con psql (usano \gexec).
// Vedi § "Note operative" a fondo file e src/util/prismaClient.ts per il lato applicativo.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  // Runtime: ruolo `bluman_app`, soggetto alle policy RLS.
  url       = env("DATABASE_URL")
  // Migrazioni e introspezione: ruolo proprietario dello schema. Serve separato perché
  // `bluman_app` non ha CREATE su public — di proposito, così lo schema lo cambiano solo
  // le migrazioni. Senza questa riga `prisma migrate deploy` fallirebbe sui permessi.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────
// FONDAMENTA — §2bis, §14
// ─────────────────────────────────────────────────────────────────

model Tenant {
  id                   String   @id @default(uuid())
  ragioneSociale       String   @map("ragione_sociale")
  piva                 String?  @map("piva")
  codiceFiscale        String?  @map("codice_fiscale")
  sedeLegale           String?  @map("sede_legale")
  sedeOperativa        String?  @map("sede_operativa")
  logoUrl              String?  @map("logo_url")
  coloreTemaFattura    String?  @map("colore_tema_fattura")
  notePieFattura       String?  @map("note_pie_fattura")
  titoloIntestazione   String?  @map("titolo_intestazione")
  iban                 String?  @map("iban")
  email                String?  @map("email")
  pec                  String?  @map("pec")
  telefono             String?  @map("telefono")
  /// Concessione moduli dalla PIATTAFORMA (super_admin) allo studio — il "piano": elenco di chiavi
  /// modulo disponibili. Si combina con `moduliDisattivati` (più sotto, deciso dall'admin dello
  /// studio): un modulo è attivo se è concesso E non disattivato. Solo `kyc` è cablato per ora.
  moduliConcessi       Json?    @map("moduli_concessi")
  waPhoneId            String?  @map("wa_phone_id")
  waAccessToken        String?  @map("wa_access_token")
  /// Token dell'handshake GET di Meta. È **per studio** perché appartiene all'app dello studio:
  /// Meta configura Callback URL e Verify Token per applicazione, non per numero.
  waVerifyToken        String?  @map("wa_verify_token")
  /// Identificativi dell'app Meta dello studio (App ID e App Secret): l'App Secret è la chiave
  /// con cui si verifica la firma `X-Hub-Signature-256` dei messaggi in ingresso.
  waAppId              String?  @map("wa_app_id")
  waAppSecret          String?  @map("wa_app_secret")
  /// Discriminante del path di callback (`/webhooks/communications/whatsapp/<slug>`), generato
  /// con entropia dal database e mai versionato. Serve a dedurre lo studio dall'URL, e quindi a
  /// leggere il suo App Secret, senza una ricerca cross-tenant sul `phone_number_id`.
  waWebhookSlug        String?  @unique @map("wa_webhook_slug")
  /// Nome e lingua del template di autenticazione approvato: vivono nell'app dello studio, non
  /// in una variabile di piattaforma, perché è la sua app che li ha fatti approvare.
  waOtpTemplate        String?  @map("wa_otp_template")
  waOtpTemplateLang    String?  @map("wa_otp_template_lang")
  tgBotToken           String?  @map("tg_bot_token")
  tgBotUsername        String?  @map("tg_bot_username")
  smtpHost             String?  @map("smtp_host")
  /// Nome che il certificato del server SMTP deve attestare, quando è diverso dall'host a cui
  /// si collega (SNI dichiarato). Vuoto: si verifica contro `smtpHost`, come di norma.
  smtpServername       String?  @map("smtp_servername")
  smtpPort             Int?     @map("smtp_port")
  smtpSecure           Boolean? @default(false) @map("smtp_secure")
  smtpUser             String?  @map("smtp_user")
  smtpPass             String?  @map("smtp_pass")
  smtpFromEmail        String?  @map("smtp_from_email")
  smtpFromName         String?  @map("smtp_from_name")
  smtpReplyTo          String?  @map("smtp_reply_to")
  smtpBcc              String?  @map("smtp_bcc")
  imapHost             String?  @map("imap_host")
  /// Nome che il certificato del server IMAP deve attestare. Serve dove il nome coperto dal
  /// certificato non ha record DNS e l'indirizzo raggiungibile ne ha un altro: la connessione
  /// va all'host, la verifica al nome dichiarato qui. Vuoto: si verifica contro `imapHost`.
  imapServername       String?  @map("imap_servername")
  imapPort             Int?     @map("imap_port")
  imapSecure           Boolean? @default(true) @map("imap_secure")
  imapUser             String?  @map("imap_user")
  imapPass             String?  @map("imap_pass")
  imapFolder           String?  @default("INBOX") @map("imap_folder")
  imapPollInterval     String?  @default("5m") @map("imap_poll_interval")
  imapProtocol         String?  @default("imap") @map("imap_protocol")
  emailSignatureHtml   String?  @map("email_signature_html")
  regimeFiscale        String?  @map("regime_fiscale")
  capitaleSociale      String?  @map("capitale_sociale")
  regImprese           String?  @map("reg_imprese")
  mostraSdi            Boolean? @default(true) @map("mostra_sdi")
  mostraIva            Boolean? @default(true) @map("mostra_iva")
  // §Standby moduli: chiavi dei moduli che lo studio ha messo «in standby» (non usa per ora).
  // Nascosti dalla navigazione per tutto lo studio; lo decide l'admin da Impostazioni.
  moduliDisattivati    Json?    @map("moduli_disattivati")
  emailInboundParseUrl String?  @map("email_inbound_parse_url")
  /// Indirizzo base del `signal-cli-rest-api` **dello studio** (es. `https://signal.studio.it`).
  /// Prima si chiamava `signal_cli_endpoint`: la migrazione `20260916190000_signal_per_studio`
  /// aggiunge questa colonna e ci copia il valore, poi si potrà togliere la vecchia. Non è una
  /// rinomina in un colpo solo perché il backend già in esecuzione legge `signal_cli_endpoint`
  /// in molte query senza `select`, e rinominarla durante il deploy le farebbe fallire tutte.
  signalEndpoint       String?  @map("signal_endpoint")
  /// Token del reverse proxy che espone il demone. `signal-cli-rest-api` non ha autenticazione
  /// propria: senza un proxy che la imponga, chiunque raggiunga l'indirizzo può leggere e
  /// spedire i messaggi del numero dello studio. Se il campo è vuoto si prova comunque (un
  /// demone su rete privata può non averne bisogno), ma l'interfaccia lo dichiara.
  signalToken          String?  @map("signal_token")
  /// Numero Signal registrato su quel demone: è il *mittente*, e per la ricezione è anche la
  /// casella da leggere (`GET /v1/receive/{number}`).
  signalNumber         String?  @map("signal_number")
  leadAdvisorNome      String?  @map("lead_advisor_nome")
  leadAdvisorEmail     String?  @map("lead_advisor_email")
  // `lead_advisor_password` è stata eliminata dalla migrazione
  // 20260819_rimozione_password_chiaro_tenant: conteneva la password del responsabile
  // dello studio in chiaro. Le password sono solo hash scrypt su `user.password_hash`.
  giurisdizione        String?  @map("giurisdizione")
  durataMesi           Int?     @default(12) @map("durata_mesi")
  dataAttivazione      String?  @map("data_attivazione")
  dataScadenza         String?  @map("data_scadenza")
  piano                String   @default("enterprise")
  stato                String   @default("attivo") // attivo|sospeso|trial
  createdAt            DateTime @default(now()) @map("created_at")

  users               User[]
  clienti             Cliente[]
  articoli            Articolo[]
  moduli              ModuloTemplate[]
  giurisdizioni       Giurisdizione[]
  auditLogs           AuditLog[]
  comunicazioni       ComunicazioneProgetto[]
  webhookInbox        WebhookInbox[]
  contrattiRicorrenti ContrattoRicorrente[]
  contiBancari        ContoBancario[]
  permessiModuli      PermessoModulo[]
  modelliDocumenti    ModelloDocumentoCustom[]
  magicLinks          MagicLink[]
  codiciOtp           CodiceOtp[]
  firme               FirmaElettronica[]
  proposteDatiFiscale PropostaDatiFiscale[]
  richiesteAddendum   RichiestaAddendum[]
  oreTimesheet        OraTimesheet[]
  auditLogFatture     AuditLogFattura[]
  fornitori           Fornitore[]
  fattureRicevute     FatturaRicevuta[]
  liquidazioniIva     LiquidazioneIva[]
  movimentiPrimaNota  MovimentoPrimaNota[]
  collegamentiChat    CollegamentoChatProgetto[]

  @@map("tenant")
}

enum RuoloUtente {
  super_admin
  advisor
  collaboratore_interno
  collaboratore_esterno
  cliente
}

enum StatoUtente {
  attivo
  invitato
  disattivato
}

model User {
  id                   String      @id @default(uuid())
  tenantId             String?     @map("tenant_id") // nullable SOLO se ruolo=super_admin — vedi §2bis
  tenant               Tenant?     @relation(fields: [tenantId], references: [id])
  nome                 String
  email                String      @unique
  ruolo                RuoloUtente
  stato                StatoUtente @default(invitato)
  // §23 — nullable perché il cliente è passwordless (accesso solo a magic link);
  // solo advisor/collaboratore_interno/collaboratore_esterno/super_admin ne hanno una
  passwordHash         String?     @map("password_hash")
  // Incrementata a ogni cambio/reset password: revoca tutti i JWT emessi prima.
  sessionVersion       Int         @default(0) @map("session_version")
  // §23 — obbligatorio per ruolo=super_admin prima di poter fare qualunque azione oltre al login
  totpSecret           String?     @map("totp_secret")
  totpAbilitato        Boolean     @default(false) @map("totp_abilitato")
  totpBackupCodes      String[]    @default([]) @map("totp_backup_codes")
  totpIpFidati         String[]    @default([]) @map("totp_ip_fidati")
  specializzazione     String?     @map("specializzazione")
  costoOrarioCentesimi Int?        @default(3000) @map("costo_orario_centesimi") // Costo orario interno studio per margine netto
  createdAt            DateTime    @default(now()) @map("created_at")

  microvociAssegnate MicrovoceProgetto[] @relation("RisorsaAssegnata")
  eventiCreati       EventoCalendario[]
  eventiAssegnati    EventoCalendario[]  @relation("EventiAssegnati")
  accessiRicevuti    AccessoRisorsa[]    @relation("AccessoUtente")
  accessiInvitati    AccessoRisorsa[]    @relation("AccessoInvitatoDa")
  notificheRicevute  Notifica[]
  permessiModuli     PermessoModulo[]
  documentiCaricati  Documento[]
  // §Blocco 6.1 — registro ore settimanale: righe registrate, approvate o rifiutate
  oreRegistrate      OraTimesheet[]      @relation("TimesheetUtente")
  oreApprovate       OraTimesheet[]      @relation("TimesheetApprovatore")
  oreRifiutate       OraTimesheet[]      @relation("TimesheetRifiutante")

  @@map("user")
}

model Cliente {
  id                     String   @id @default(uuid())
  tenantId               String   @map("tenant_id")
  tenant                 Tenant   @relation(fields: [tenantId], references: [id])
  nome                   String
  tipo                   String // individual|company — §2
  email                  String?  @map("email")
  // Recapiti a cui può arrivare il codice OTP di firma. Prima non esistevano in anagrafica:
  // il portale teneva il numero del firmatario cablato nel sorgente, quindi l'OTP di
  // qualunque cliente partiva verso lo stesso telefono. Il recapito è un dato del cliente,
  // non una costante del frontend.
  cellulare              String?  @map("cellulare")
  // Chat id numerica, non lo @username: sendMessage vuole la chat, e la chat esiste solo
  // dopo che il cliente ha scritto almeno una volta al bot dello studio.
  telegramChatId         String?  @map("telegram_chat_id")
  // whatsapp|email|telegram — solo la preselezione. La scelta del canale resta del
  // firmatario a ogni firma; null significa "nessuna preferenza registrata".
  canaleOtpPreferito     String?  @map("canale_otp_preferito")
  passwordHash           String?  @map("password_hash")
  // Incrementata a ogni cambio/reset password o revoca credenziali del portale.
  sessionVersion         Int      @default(0) @map("session_version")
  piva                   String?  @map("piva")
  codiceFiscale          String?  @map("codice_fiscale")
  giurisdizione          String?  @map("giurisdizione")
  sedeLegale             String?  @map("sede_legale")
  sdiCode                String?  @map("sdi_code")
  // Regime IVA del cliente: guida l'aliquota della fattura invece del 22% fisso di prima.
  // `aliquotaIvaDefault` null = nessun regime registrato → si ripiega sul tipo del documento
  // (estero = 0). `naturaEsenzioneDefault` è il codice (N1..N7) da riportare in fattura quando
  // l'aliquota è 0 — un cliente esente senza codice resta un dato da completare in anagrafica,
  // non una natura inventata qui.
  aliquotaIvaDefault     Int?     @map("aliquota_iva_default")
  naturaEsenzioneDefault String?  @map("natura_esenzione_default")
  iban                   String?  @map("iban")
  rischioAml             String?  @map("rischio_aml")
  ubo                    String?  @map("ubo")
  fontePatrimonio        String?  @map("fonte_patrimonio")
  dataKyc                String?  @map("data_kyc")
  // Dati anagrafici del guest/persona fisica (per template documenti + KYC Malta). Stringhe
  // libere come dataKyc: valorizzate dal form anagrafica, opzionali.
  documentoTipo          String?  @map("documento_tipo") // carta_identita | passaporto | altro
  documentoNumero        String?  @map("documento_numero")
  dataNascita            String?  @map("data_nascita")
  luogoNascita           String?  @map("luogo_nascita")
  indirizzoResidenza     String?  @map("indirizzo_residenza")
  indirizzoAlloggio      String?  @map("indirizzo_alloggio")
  referentiJson          Json?    @map("referenti_json")
  createdAt              DateTime @default(now()) @map("created_at")

  progetti             Progetto[]
  preventivi           Preventivo[]
  contrattiRicorrenti  ContrattoRicorrente[]
  magicLinks           MagicLink[]
  codiciOtp            CodiceOtp[]
  firme                FirmaElettronica[]
  proposteDatiFiscale  PropostaDatiFiscale[]
  richiesteAddendum    RichiestaAddendum[]
  richiesteModificaDoc RichiestaModificaDocumento[] @relation("RichiesteModificaDocumento")
  notifiche            Notifica[]
  fatture              Fattura[]
  movimentiPrimaNota   MovimentoPrimaNota[]
  collegamentiChat     CollegamentoChatProgetto[]
  eventiCalendario     EventoCalendario[]           @relation("EventiCliente")
  fascicoliKyc         FascicoloKyc[]
  soggettiKyc          SoggettoKyc[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, nome])
  @@map("cliente")
}

// ─────────────────────────────────────────────────────────────────
// LIBRERIA — DISTINTA BASE (§3bis, §30)
// Solo creazione in MVP: niente endpoint di modifica contenuto,
// versionamento vero e ripubblicazione rimandati a V2 (§30).
// ─────────────────────────────────────────────────────────────────

model Articolo {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  nome                 String
  categoria            String
  versione             Int      @default(1)
  oreDefault           Int      @map("ore_default")
  prezzoDefault        Int      @map("prezzo_default") // in centesimi, mai float per denaro
  documentoAllegatoUrl String?  @map("documento_allegato_url")
  formMasterId         String?  @map("form_master_id")
  linkIstruzioni       String?  @map("link_istruzioni")
  isUltimaVersione     Boolean  @default(true) @map("is_ultima_versione")
  isAttivo             Boolean  @default(true) @map("is_attivo") // §30: disattiva, non elimina
  createdAt            DateTime @default(now()) @map("created_at")

  righeDistinta     RigaDistinta[]
  passaggiTemplate  PassaggioTemplate[]
  microvociProgetto MicrovoceProgetto[]
  fattureRiga       FatturaRiga[]

  // §Blocco 7 (fix) — anti-duplicato: stesso tenant non può avere due articoli
  // con lo stesso nome alla stessa versione (i doppioni seed/UI sono stati
  // ripuliti con scripts/pulizia-duplicati-catalogo.mjs).
  @@unique([tenantId, nome, versione])
  @@map("articolo")
}

model ModuloTemplate {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  nome             String
  categoria        String
  versione         Int            @default(1)
  prezzoPacchetto  Int?           @map("prezzo_pacchetto") // override della somma righe, §3bis/§7
  isUltimaVersione Boolean        @default(true) @map("is_ultima_versione")
  isAttivo         Boolean        @default(true) @map("is_attivo")
  giurisdizioneId  String?        @map("giurisdizione_id")
  giurisdizione    Giurisdizione? @relation(fields: [giurisdizioneId], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at")

  righeDistinta  RigaDistinta[]
  dipendenze     ModuloDipendenzaTemplate[] @relation("ModuloDipendente")
  dipendenzeDi   ModuloDipendenzaTemplate[] @relation("ModuloDaCuiDipende")
  moduliProgetto ModuloProgetto[]

  // §Blocco 7 (fix) — anti-duplicato: stesso tenant non può avere due moduli
  // con lo stesso nome alla stessa versione.
  @@unique([tenantId, nome, versione])
  @@map("modulo_template")
}

enum TipoGiurisdizione {
  ue
  extra_ue
  stato_usa
  altro
}

model Giurisdizione {
  id        String            @id @default(uuid())
  tenantId  String            @map("tenant_id")
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  nome      String
  codice    String
  tipo      TipoGiurisdizione @default(ue)
  note      String?
  createdAt DateTime          @default(now()) @map("created_at")

  moduli   ModuloTemplate[]
  progetti Progetto[]

  @@map("giurisdizione")
}

model RigaDistinta {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  moduloTemplateId String         @map("modulo_template_id")
  moduloTemplate   ModuloTemplate @relation(fields: [moduloTemplateId], references: [id])
  articoloId       String         @map("articolo_id")
  articolo         Articolo       @relation(fields: [articoloId], references: [id])
  articoloVersione Int            @map("articolo_versione") // pinned alla pubblicazione, §3bis
  ordine           Int
  quantita         Int            @default(1)
  overrideOre      Int?           @map("override_ore")
  overridePrezzo   Int?           @map("override_prezzo")
  obbligatorio     Boolean        @default(true)

  microvociGenerate MicrovoceProgetto[]

  @@map("riga_distinta")
}

enum TipoPassaggio {
  info
  documento
  form
  verifica
}

enum ChiPassaggio {
  operatore
  cliente
}

model PassaggioTemplate {
  id            String        @id @default(uuid())
  articoloId    String        @map("articolo_id")
  articolo      Articolo      @relation(fields: [articoloId], references: [id])
  titolo        String
  tipo          TipoPassaggio
  chi           ChiPassaggio
  ordine        Int
  descrizione   String?
  campiFormJson Json?         @map("campi_form_json")

  @@map("passaggio_template")
}

model ModuloDipendenzaTemplate {
  id                        String         @id @default(uuid())
  tenantId                  String         @map("tenant_id")
  moduloTemplateId          String         @map("modulo_template_id")
  moduloTemplate            ModuloTemplate @relation("ModuloDipendente", fields: [moduloTemplateId], references: [id])
  dipendeDaModuloTemplateId String         @map("dipende_da_modulo_template_id")
  dipendeDaModuloTemplate   ModuloTemplate @relation("ModuloDaCuiDipende", fields: [dipendeDaModuloTemplateId], references: [id])
  // Verifica anti-ciclo: applicativa, non esprimibile come vincolo DB semplice — §7ter, §30

  @@map("modulo_dipendenza_template")
}

// ─────────────────────────────────────────────────────────────────
// PRE-PROGETTO — §15
// ─────────────────────────────────────────────────────────────────

enum StatoPreventivo {
  bozza
  inviato
  accettato
  rifiutato
}

model Preventivo {
  id           String          @id @default(uuid())
  tenantId     String          @map("tenant_id")
  clienteId    String          @map("cliente_id")
  cliente      Cliente         @relation(fields: [clienteId], references: [id])
  // §15.2 richiede progetto_id nel body di creazione ma §14 non lo includeva nello schema
  // originale — incoerenza trovata implementando l'adapter Prisma, corretta qui.
  progettoId   String          @map("progetto_id")
  progetto     Progetto        @relation(fields: [progettoId], references: [id], onDelete: Cascade)
  stato        StatoPreventivo @default(bozza)
  righeJson    Json            @map("righe_json") // [{moduloTemplateId, moduloTemplateVersione}]
  valoreTotale Int             @map("valore_totale")
  createdAt    DateTime        @default(now()) @map("created_at")

  engagementLetter EngagementLetter?
  fatture          Fattura[]

  @@map("preventivo")
}

model EngagementLetter {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  preventivoId String     @unique @map("preventivo_id")
  preventivo   Preventivo @relation(fields: [preventivoId], references: [id])
  statoFirma   String     @default("in_attesa") @map("stato_firma") // in_attesa|completata
  linkFirma    String?    @map("link_firma")
  firmatoAt    DateTime?  @map("firmato_at")
  // Punto 3 piano gap — come per Documento: mai hard-delete, solo archiviazione.
  isArchiviato Boolean    @default(false) @map("is_archiviato")

  @@map("engagement_letter")
}

// ─────────────────────────────────────────────────────────────────
// PROGETTO ATTIVO — §14, §15.3, §16
// ─────────────────────────────────────────────────────────────────

enum StatoProgetto {
  pre_project
  in_progress
  completed
  archived
}

model Progetto {
  id                      String         @id @default(uuid())
  tenantId                String         @map("tenant_id")
  clienteId               String         @map("cliente_id")
  cliente                 Cliente        @relation(fields: [clienteId], references: [id])
  nome                    String
  stato                   StatoProgetto  @default(pre_project)
  dataInizio              DateTime?      @map("data_inizio")
  dataScadenza            DateTime?      @map("data_scadenza")
  valoreTotale            Int            @map("valore_totale")
  giurisdizionePrimariaId String?        @map("giurisdizione_primaria_id")
  giurisdizionePrimaria   Giurisdizione? @relation(fields: [giurisdizionePrimariaId], references: [id])
  // §2.8 — numero progressivo della lettera d'incarico (EL-<anno>-<seq>), assegnato dal
  // backend alla creazione e unico nel tenant per anno. Prima il portale mostrava a tutti
  // lo stesso numero cablato (EL-2026-089).
  numeroContratto         String?        @map("numero_contratto")
  createdAt               DateTime       @default(now()) @map("created_at")

  moduli              ModuloProgetto[]
  preventivi          Preventivo[]
  documenti           Documento[]
  fatture             Fattura[]
  eventi              EventoCalendario[]
  accessiRisorsa      AccessoRisorsa[]           @relation("AccessoProgetto")
  comunicazioni       ComunicazioneProgetto[]
  contrattiRicorrenti ContrattoRicorrente[]
  richiesteAddendum   RichiestaAddendum[]
  oreTimesheet        OraTimesheet[]
  collegamentiChat    CollegamentoChatProgetto[]

  @@index([tenantId, clienteId])
  // Indici performance (migrazione 20260912150000_indici_performance):
  // dashboard "progetti in ritardo": WHERE tenant_id=? AND stato IN ('in_corso','bloccato')
  @@index([tenantId, stato])
  // paginazione GET /progetti: WHERE tenant_id=? ORDER BY created_at DESC
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("progetto")
}

enum StatoModulo {
  pending
  attesa_dipendenza
  in_progress
  delayed
  blocked
  done
}

model ModuloProgetto {
  id                     String         @id @default(uuid())
  tenantId               String         @map("tenant_id")
  progettoId             String         @map("progetto_id")
  progetto               Progetto       @relation(fields: [progettoId], references: [id], onDelete: Cascade)
  moduloTemplateId       String         @map("modulo_template_id")
  moduloTemplate         ModuloTemplate @relation(fields: [moduloTemplateId], references: [id])
  moduloTemplateVersione Int            @map("modulo_template_versione") // congelata alla creazione, §15.3
  nome                   String
  categoria              String
  prezzo                 Int
  orePreventivate        Int            @map("ore_preventivate")
  oreConsuntivate        Int            @default(0) @map("ore_consuntivate")
  stato                  StatoModulo    @default(pending)
  // stato calcolato da calcolaStatoModulo (§16.2) — mai scritto manualmente
  // salvo eccezione esplicita e tracciata (§16.6)

  microvoci        MicrovoceProgetto[]
  dipendenze       ModuloProgettoDipendenza[] @relation("ModuloProgettoDipendente")
  dipendenzeDi     ModuloProgettoDipendenza[] @relation("ModuloProgettoDaCuiDipende")
  fattureRiga      FatturaRiga[]
  accessiRisorsa   AccessoRisorsa[]           @relation("AccessoModulo")
  eventiCalendario EventoCalendario[]         @relation("EventiModulo")

  // La lista progetti fa una include annidata (progetto → moduli → microvoci): senza
  // indice sulla FK Postgres scansiona l'intera tabella a ogni caricamento.
  @@index([progettoId])
  @@map("modulo_progetto")
}

enum StatoMicrovoce {
  pending
  attesa_dipendenza
  active
  delayed
  blocked
  done
}

model MicrovoceProgetto {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  moduloProgettoId String         @map("modulo_progetto_id")
  moduloProgetto   ModuloProgetto @relation(fields: [moduloProgettoId], references: [id])
  articoloId       String         @map("articolo_id")
  articolo         Articolo       @relation(fields: [articoloId], references: [id])
  articoloVersione Int            @map("articolo_versione") // congelata, §15.3
  rigaDistintaId   String         @map("riga_distinta_id") // traccia la riga di origine — utile con quantità > 1
  rigaDistinta     RigaDistinta   @relation(fields: [rigaDistintaId], references: [id])
  nome             String // denormalizzato da articolo.nome
  orePreventivate  Int            @map("ore_preventivate")
  oreConsuntivate  Int            @default(0) @map("ore_consuntivate")
  stato            StatoMicrovoce @default(pending)
  segnaleRischio   Boolean        @default(false) @map("segnale_rischio") // calcolato, §16.1 — non è uno stato
  oreExtra         Int            @default(0) @map("ore_extra")
  causaNota        String?        @map("causa_nota") // obbligatoria quando stato passa a delayed/blocked, §7bis
  risorsaId        String?        @map("risorsa_id")
  risorsa          User?          @relation("RisorsaAssegnata", fields: [risorsaId], references: [id])
  ordine           Int

  passaggi         PassaggioProgetto[]
  documenti        Documento[]
  accessiRisorsa   AccessoRisorsa[]    @relation("AccessoMicrovoce")
  eventiCalendario EventoCalendario[]  @relation("EventiMicrovoce")

  // FK verso il modulo padre: risolve la include annidata della lista progetti.
  @@index([moduloProgettoId])
  @@map("microvoce_progetto")
}

model PassaggioProgetto {
  id                    String            @id @default(uuid())
  tenantId              String            @map("tenant_id")
  microvoceProgettoId   String            @map("microvoce_progetto_id")
  microvoceProgetto     MicrovoceProgetto @relation(fields: [microvoceProgettoId], references: [id])
  titolo                String
  tipo                  TipoPassaggio
  chi                   ChiPassaggio
  ordine                Int // liberamente riordinabile per questa istanza, mai sul template
  descrizione           String?
  campiFormJson         Json?             @map("campi_form_json")
  stato                 String            @default("pending") // pending|done
  documentoId           String?           @unique @map("documento_id")
  documento             Documento?        @relation(fields: [documentoId], references: [id])
  risposteFormJson      Json?             @map("risposte_form_json")
  noteOperatoreJson     Json?             @map("note_operatore_json")
  richiedeFirmaCliente  Boolean           @default(false) @map("richiede_firma_cliente")
  // Piano firma §3.1 (Fase 2) — valore legale richiesto (ses|fea|feq) per la conferma
  // firmata di questo passaggio/modulo. Finché la firma non è apposta resta cambiabile;
  // dopo diventa storia. Con fea/feq la rotta OTP semplice risponde 409.
  livelloFirmaRichiesto String            @default("ses") @map("livello_firma_richiesto")
  documentoAllegatoUrl  String?           @map("documento_allegato_url")
  formMasterId          String?           @map("form_master_id")
  linkIstruzioni        String?           @map("link_istruzioni")
  checklistVoci         ChecklistVoce[]

  // FK verso la micro-voce: i passaggi si caricano per micro-voce nell'esecuzione (§17).
  @@index([microvoceProgettoId])
  @@map("passaggio_progetto")
}

model ModelloDocumentoInBianco {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  nome                  String
  categoria             String
  fileUrl               String   @map("file_url")
  richiedeFirma         Boolean  @default(true) @map("richiede_firma")
  // Piano firma §3.1 (Fase 2) — livello di valore legale (ses|fea|feq) imposto a ogni
  // documento generato da questo template. Copiato su Documento alla generazione.
  livelloFirmaRichiesto String   @default("ses") @map("livello_firma_richiesto")
  descrizione           String?
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("modello_documento_in_bianco")
}

model FormMaster {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  nome      String
  campiJson Json     @map("campi_json")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("form_master")
}

model ModuloProgettoDipendenza {
  id                        String         @id @default(uuid())
  tenantId                  String         @map("tenant_id")
  moduloProgettoId          String         @map("modulo_progetto_id")
  moduloProgetto            ModuloProgetto @relation("ModuloProgettoDipendente", fields: [moduloProgettoId], references: [id])
  dipendeDaModuloProgettoId String         @map("dipende_da_modulo_progetto_id")
  dipendeDaModuloProgetto   ModuloProgetto @relation("ModuloProgettoDaCuiDipende", fields: [dipendeDaModuloProgettoId], references: [id])
  // copia congelata delle dipendenze del template al momento dell'istanziazione, §15.3

  @@map("modulo_progetto_dipendenza")
}

enum StatoScansione {
  in_corso
  pulito
  infetto
}

/// §WF-DOC — Ciclo di vita del documento nel workflow operatore-cliente.
/// bozza: visibile solo all'operatore.
/// pubblicato: il cliente può vedere, firmare o chiedere modifiche.
/// in_revisione: il cliente ha richiesto una modifica (torna a bozza dopo upload v2).
/// firmato: il cliente ha firmato via OTP — stato terminale positivo.
enum StatoDocumento {
  bozza
  pubblicato
  in_revisione
  firmato
}

model Documento {
  id                    String             @id @default(uuid())
  tenantId              String             @map("tenant_id")
  // §2.9 — i file caricati dallo studio appartengono al fascicolo del progetto, non per
  // forza a una micro-voce (che può non esistere ancora: upload prima dell'istanziazione).
  // Almeno uno dei due collegamenti è sempre valorizzato.
  microvoceProgettoId   String?            @map("microvoce_progetto_id")
  microvoceProgetto     MicrovoceProgetto? @relation(fields: [microvoceProgettoId], references: [id], onDelete: SetNull)
  progettoId            String?            @map("progetto_id")
  progetto              Progetto?          @relation(fields: [progettoId], references: [id], onDelete: SetNull)
  tipo                  String // template_vuoto|compilato|firmato|allegato|verbale_firma
  // Punto 1 piano gap — export contestuale PDF + Word. `fileUrl` resta il master
  // (retrocompatibilità: tutto il codice esistente, incluso l'hash legale della firma
  // calcolato da `leggiFileArchivio(fileUrl)`, continua a puntare qui). I due campi
  // sotto indicano la disponibilità del doppio formato e si popolano solo per i
  // documenti prodotti dal motore di generazione (tipo=`compilato`), non per gli
  // `allegato` caricati manualmente nel loro formato originale. `formatoOrigine`
  // dichiara qual è il master: per i generati è sempre 'pdf' (sigillo legale sul PDF).
  fileUrl               String             @map("file_url")
  filePdfUrl            String?            @map("file_pdf_url")
  fileDocxUrl           String?            @map("file_docx_url")
  formatoOrigine        String             @default("pdf") @map("formato_origine") // pdf|docx
  // §36 — i blocchi risolti da cui il documento è stato composto, così com'erano al momento
  // della generazione (tag già sostituiti). Servono a una cosa sola: quando il cliente firma,
  // ricomporre il documento con la grafometrica DENTRO l'area `{{firma_cliente}}`. Il PDF
  // originale non si può annotare (nessun `pdf-lib` fra le dipendenze) e non si DEVE toccare —
  // è il file su cui è fissato l'hash del sigillo. La copia firmata è quindi una nuova riga
  // Documento (tipo='firmato', documentoPadreId → originale) resa da questi stessi blocchi.
  // Nullable e senza backfill: i documenti generati prima di §36 non hanno i blocchi, e per
  // loro la copia firmata non si produce (la firma resta valida, sigillo e verbale invariati).
  contenutoBlocchiJson  Json?              @map("contenuto_blocchi_json")
  versione              Int                @default(1)
  // Chi ha caricato il file. Nullable: i documenti generati automaticamente dalla
  // piattaforma (verbale_firma, Punto 2 piano gap) non hanno un caricatore umano — il
  // client firmatario non è una riga User e attribuirlo a un utente dello studio sarebbe
  // un'attestazione falsa in un atto certificativo.
  caricatoDa            String?            @map("caricato_da")
  caricatoDaUser        User?              @relation(fields: [caricatoDa], references: [id])
  createdAt             DateTime           @default(now()) @map("created_at")
  // Sicurezza upload — §28, incluso fin dallo schema iniziale (Fase 1 del piano)
  statoScansione        StatoScansione     @default(in_corso) @map("stato_scansione")
  scansionatoAt         DateTime?          @map("scansionato_at")
  dataScadenzaDoc       DateTime?          @map("data_scadenza_doc")
  categoriaDoc          String?            @default("generico") @map("categoria_doc") // identita|visura|contratto|generico
  avvisoScadenzaInviato Boolean            @default(false) @map("avviso_scadenza_inviato")
  // §WF-DOC — Workflow operatore → cliente.
  // Ogni upload parte come bozza: l'operatore pubblica esplicitamente quando il documento è pronto.
  statoDoc              StatoDocumento     @default(bozza) @map("stato_doc")
  pubblicatoAt          DateTime?          @map("pubblicato_at")
  // Piano firma §3.1 (Fase 2) — valore legale richiesto (ses|fea|feq) per firmare questo
  // documento. I generati lo ereditano dal template; per gli upload manuali lo sceglie
  // l'operatore alla pubblicazione. Cambiabile finché la firma non è apposta.
  livelloFirmaRichiesto String             @default("ses") @map("livello_firma_richiesto")
  // Versioning: documentoPadreId punta alla riga v1 quando si carica una v2 corretta.
  documentoPadreId      String?            @map("documento_padre_id")
  documentoPadre        Documento?         @relation("VersioniDocumento", fields: [documentoPadreId], references: [id])
  versioni              Documento[]        @relation("VersioniDocumento")
  // Punto 3 piano gap — un documento firmato (o con sigillo/OTP collegati) non si cancella
  // mai: viene solo archiviato. Le liste operative escludono isArchiviato=true, lo storico
  // e l'audit restano leggibili e il riferimento della firma non diventa mai orfano.
  isArchiviato          Boolean            @default(false) @map("is_archiviato")
  archiviatoAt          DateTime?          @map("archiviato_at")
  archiviatoDaId        String?            @map("archiviato_da_id")

  passaggioProgetto PassaggioProgetto?
  richiesteModifica RichiestaModificaDocumento[]
  verbaliFirma      FirmaElettronica[]

  @@index([progettoId])
  @@index([statoDoc])
  @@index([tenantId, progettoId, isArchiviato])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("documento")
}

/// §WF-DOC — Richiesta di modifica inviata dal cliente su un documento pubblicato.
/// Ogni richiesta è registrata a DB e visibile all'advisor nella scheda del documento.
model RichiestaModificaDocumento {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  documentoId    String    @map("documento_id")
  documento      Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  clienteId      String    @map("cliente_id")
  cliente        Cliente   @relation("RichiesteModificaDocumento", fields: [clienteId], references: [id])
  commento       String // testo libero del cliente
  stato          String    @default("aperta") // aperta | risolta
  creatoAt       DateTime  @default(now()) @map("creato_at")
  rispostoAt     DateTime? @map("risposto_at")
  rispostaStudio String?   @map("risposta_studio")

  @@index([documentoId])
  @@index([tenantId, stato])
  @@map("richiesta_modifica_documento")
}

model ChecklistVoce {
  id                  String            @id @default(uuid())
  tenantId            String            @map("tenant_id")
  passaggioProgettoId String            @map("passaggio_progetto_id")
  passaggioProgetto   PassaggioProgetto @relation(fields: [passaggioProgettoId], references: [id], onDelete: Cascade)
  titolo              String
  obbligatorio        Boolean           @default(false)
  completato          Boolean           @default(false)
  completatoDa        String?           @map("completato_da")
  completatoAt        DateTime?         @map("completato_at")

  @@map("checklist_voce")
}

enum FrequenzaContratto {
  mensile
  trimestrale
  semestrale
  annuale
}

enum StatoContrattoRicorrente {
  attivo
  sospeso
  concluso
}

model ContrattoRicorrente {
  id                   String                   @id @default(uuid())
  tenantId             String                   @map("tenant_id")
  tenant               Tenant                   @relation(fields: [tenantId], references: [id])
  clienteId            String                   @map("cliente_id")
  cliente              Cliente                  @relation(fields: [clienteId], references: [id])
  progettoId           String?                  @map("progetto_id")
