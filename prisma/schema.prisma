  numeroRata       Int                  @default(1) @map("numero_rata")
  importoCentesimi Int                  @map("importo_centesimi")
  dataScadenza     DateTime             @map("data_scadenza")
  stato            StatoScadenzaIncasso @default(in_attesa)
  note             String?

  registrazioniRegistrate RegistrazioneIncasso[]

