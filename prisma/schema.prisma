model Notifica {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  // Blocco 3: il destinatario è un utente dello studio OPPURE un cliente del portale.
  // I due FK sono entrambi opzionali: esattamente uno dei due è valorizzato.
  destinatarioId        String?   @map("destinatario_id")
  destinatarioUser      User?     @relation(fields: [destinatarioId], references: [id])
  destinatarioClienteId String?   @map("destinatario_cliente_id")
  destinatarioCliente   Cliente?  @relation(fields: [destinatarioClienteId], references: [id])
  destinatarioTipo      String    @map("destinatario_tipo") // user|cliente
  // Evento origine (Blocco 3): modulo_completato|documento_da_firmare|messaggio_cliente|
  // scadenza_imminente|fattura_incassata|firma_apposta|messaggio_non_instradabile|
  // chat_collegata_progetto. Null per notifiche legacy/generiche.
  tipoEvento            String?   @map("tipo_evento")
  link                  String? // deep-link frontend (es. /projects/123, /portal)
  canale                String    @default("email")
  oggetto               String
  corpo                 String
  statoLettura          String    @default("non_letta") @map("stato_lettura")
  inviataAt             DateTime? @map("inviata_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  // Indici esistenti (per FK lookup):
  @@index([tenantId, destinatarioId])
  @@index([tenantId, destinatarioClienteId])
  // Indici performance (migrazione 20260912150000_indici_performance):
  // badge "non lette" nella topbar: WHERE tenant_id=? AND destinatario_id=? AND stato_lettura='non_letta'
  @@index([tenantId, destinatarioId, statoLettura])
  // badge portale cliente: WHERE tenant_id=? AND destinatario_cliente_id=? AND stato_lettura='non_letta'
  @@index([tenantId, destinatarioClienteId, statoLettura])
  // lista notifiche ordinata per data: WHERE tenant_id=? AND destinatario_id=? ORDER BY created_at DESC
  @@index([tenantId, destinatarioId, createdAt(sort: Desc)])
  @@map("notifica")
}

model AuditLog {
