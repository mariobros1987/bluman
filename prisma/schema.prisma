  ruolo      String   @map("ruolo")
  azione     String   // es. "DOCUMENTO_CARICATO", "DOCUMENTO_ELIMINATO", "FATTURA_EMESSA"
  entita     String   // es. "Fascicolo_KYC.pdf", "Progetto #1"
  dettagli   String   @map("dettagli")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model ComunicazioneProgetto {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  progettoId   String   @map("progetto_id")
  progetto     Progetto @relation(fields: [progettoId], references: [id], onDelete: Cascade)
  canale       String   // email | whatsapp | telegram | signal
  mittente     String
  destinatario String
  direzione    String   @default("entrata") // entrata | uscita
  testo        String
  allegatiJson String?  @map("allegati_json")
  externalId   String?  @map("external_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("comunicazione_progetto")
}

model ContoBancario {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  nomeConto     String   @map("nome_conto")
  banca         String
  iban          String?
  bicSwift      String?  @map("bic_swift")
  saldoIniziale Int      @default(0) @map("saldo_iniziale") // centesimi
  saldoAttuale  Int      @default(0) @map("saldo_attuale") // centesimi
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("conto_bancario")
}

model ModelloDocumentoCustom {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  titolo         String
  categoria      String   @default("contratto")
  descrizione    String?
  contenutoHtml  String   @map("contenuto_html") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("modello_documento_custom")
}

// ─────────────────────────────────────────────────────────────────
// MAGIC LINK — accesso passwordless del cliente al portale (§23)
// ─────────────────────────────────────────────────────────────────
// Prima di questa tabella /auth/magic-login accettava qualunque stringa che iniziasse
// per `client_` e in cambio firmava un JWT con tenant ed email cablati: non c'era
// niente da verificare, perché i token non venivano persistiti da nessuna parte. Il
// rate limiting non c'entrava — non era un problema di brute force, non c'era nulla
// da indovinare.

model MagicLink {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  clienteId String    @map("cliente_id")
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // In tabella va lo SHA-256 del token, non il token: chi legge il database non deve
  // poter entrare al posto del cliente. SHA-256 e non scrypt perché il token ha già
  // 128 bit da crypto.randomBytes — scrypt difende dalle password indovinabili, e qui
  // non c'è niente da indovinare.
  tokenHash String    @unique @map("token_hash")
  scadenza  DateTime  @map("scadenza")
  // Indirizzo a cui il link è stato inviato. Serve all'audit — un credenziale di accesso
  // senza traccia di dove è finita non è verificabile — e dà un'email al JWT di sessione:
  // `Cliente` non ne ha una, e prima l'endpoint ne cablava una nel sorgente.
  email     String?   @map("email")
  // Primo utilizzo, per l'audit. Il link resta valido fino a scadenza: un cliente
  // riapre il proprio link più di una volta, e invalidarlo al primo accesso lo
  // chiuderebbe fuori. La revoca è la cancellazione della riga.
  usatoAt   DateTime? @map("usato_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("magic_link")
}

